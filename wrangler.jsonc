{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fable-learn-with-story",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "LLM_API_URL": "",
    "LLM_MODEL": "",
    "IMAGE_API_URL": "",
    "IMAGE_MODEL": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
